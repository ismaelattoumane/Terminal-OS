# ── Base de données ─────────────────────────────────────────────
# PostgreSQL managé en production : Neon, Supabase, RDS, Railway…
DATABASE_URL="postgresql://terminal_os:terminal_os_dev@localhost:5432/terminal_os"

# ── Auth / sessions ─────────────────────────────────────────────
# Secret aléatoire (openssl rand -base64 32) — ne jamais le commiter.
AUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth / Calendar ─────────────────────────────────────
# Activent la connexion Google et la synchronisation des révisions.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# À déclarer exactement dans Google Cloud Console, autorisé même en local.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
# Fuseau utilisé pour les événements Google.
CALENDAR_TIMEZONE="Europe/Paris"

# ── Stockage S3 compatible (optionnel) ──────────────────────────
# Exemples : MinIO local (http://localhost:9000), Scaleway, Cloudflare R2, AWS S3.
# S3_ENDPOINT vide => le stockage est désactivé (les fichiers ne sont pas conservés).
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_REGION="auto"
# URL publique du bucket si les objets sont en lecture publique (optionnel).
S3_PUBLIC_URL=""

# ── IA (optionnel) ──────────────────────────────────────────────
# Réservé à un provider IA distant ; sans clé, le mode local reste fonctionnel.
AI_API_KEY=""

# ── Automatisations / observabilité ─────────────────────────────
# Secret du cron cloud (/api/automation/worker), générer aléatoirement.
CRON_SECRET="change-me-for-cloud-cron"